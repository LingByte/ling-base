package interceptor

import (
	"context"
	"fmt"
	"runtime/debug"
	"time"

	"{{.Module}}/internal/service"

	"github.com/LingByte/ling-base/logger"
	"go.uber.org/zap"
)

// Logging 日志拦截器。
func Logging(ctx context.Context, req interface{}, handler service.Handler) (interface{}, error) {
	start := time.Now()
	resp, err := handler(ctx, req)
	logger.Lg.Info("gRPC 请求",
		zap.String("duration", time.Since(start).String()),
		zap.Error(err))
	return resp, err
}

// Recover 恢复拦截器。
func Recover(ctx context.Context, req interface{}, handler service.Handler) (resp interface{}, err error) {
	defer func() {
		if rec := recover(); rec != nil {
			logger.Lg.Error("panic recovered",
				zap.Any("error", rec),
				zap.String("stack", string(debug.Stack())))
			err = fmt.Errorf("internal error")
		}
	}()
	return handler(ctx, req)
}
