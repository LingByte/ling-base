package app

import (
	"context"
	"fmt"
	"net"
	"os"
	"time"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/interceptor"
	"{{.Module}}/internal/service"

	"github.com/LingByte/ling-base/bootstrap"
	"github.com/LingByte/ling-base/constants"
	"github.com/LingByte/ling-base/logger"
	"go.uber.org/zap"
)

type AppInfo struct {
	Name      string
	Version   string
	BuildTime string
	GitCommit string
	Port      int
}

func Run(info *AppInfo) {
	cfg, err := config.Load("configs/config.yaml")
	if err != nil {
		fmt.Fprintf(os.Stderr, "加载配置失败: %v\n", err)
		os.Exit(1)
	}

	// 初始化时区
	logger.InitTimezone(constants.TimezoneShanghai)

	// 初始化日志
	if err := logger.Init(&logger.LogConfig{
		Level:           cfg.Logging.Level,
		Filename:        cfg.Logging.Filename,
		MaxSize:         cfg.Logging.MaxSize,
		MaxAge:          cfg.Logging.MaxAge,
		MaxBackups:      cfg.Logging.MaxBackups,
		Daily:           cfg.Logging.Daily,
		SensitiveFields: cfg.Logging.SensitiveFields,
	}, cfg.App.Environment); err != nil {
		fmt.Fprintf(os.Stderr, "初始化日志失败: %v\n", err)
		os.Exit(1)
	}

	appOpts := []bootstrap.Option{
		bootstrap.WithProfile(cfg.App.Environment),
		bootstrap.WithBannerText(info.Name),
		bootstrap.WithShutdownTimeout(15 * time.Second),
	}

	app := bootstrap.New(info.Name, appOpts...)
	app.Register("grpc-server", &grpcServerComponent{info: info, cfg: cfg})

	if err := app.Run(); err != nil {
		logger.Lg.Error("应用启动失败", zap.Error(err))
		os.Exit(1)
	}
}

type grpcServerComponent struct {
	info     *AppInfo
	cfg      *config.Config
	listener net.Listener
	srv      *service.Server
}

func (c *grpcServerComponent) Start(ctx context.Context) error {
	lis, err := net.Listen("tcp", fmt.Sprintf(":%d", c.info.Port))
	if err != nil {
		return fmt.Errorf("监听失败: %w", err)
	}
	c.listener = lis

	c.srv = service.NewServer()
	c.srv.UseInterceptor(interceptor.Logging)
	c.srv.UseInterceptor(interceptor.Recover)

	go func() {
		logger.Lg.Info("gRPC 服务已启动",
			zap.String("addr", lis.Addr().String()),
			zap.String("version", c.info.Version))
		if err := c.srv.Serve(lis); err != nil {
			logger.Lg.Error("gRPC 服务异常", zap.Error(err))
		}
	}()

	return nil
}

func (c *grpcServerComponent) Stop(ctx context.Context) error {
	logger.Lg.Info("正在关闭 gRPC 服务...")
	c.srv.GracefulStop()
	return nil
}
