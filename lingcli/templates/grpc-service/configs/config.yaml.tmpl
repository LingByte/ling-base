# {{.ProjectName}} gRPC 配置

server:
  port: {{.Port}}
  maxRecvMsgSize: 4194304
  maxSendMsgSize: 4194304
  timeout: 30s

logging:
  level: info
  filename: logs/grpc.log
  maxSize: 100
  maxAge: 30
  maxBackups: 10
  daily: true
  sensitiveFields: ""

app:
  name: {{.ProjectName}}
  environment: dev
