package config

import (
	"os"

	"gopkg.in/yaml.v3"
)

type Config struct {
	AppName string `yaml:"appName"`
	Debug   bool   `yaml:"debug"`
}

func Default() *Config {
	return &Config{AppName: "{{.ProjectName}}", Debug: false}
}

func Load(path string) (*Config, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return Default(), nil
	}
	cfg := Default()
	if err := yaml.Unmarshal(data, cfg); err != nil {
		return nil, err
	}
	return cfg, nil
}
