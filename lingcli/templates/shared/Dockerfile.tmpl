# ---- 构建阶段 ----
FROM golang:1.23-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app ./cmd/...

# ---- 运行阶段 ----
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app /app/app

ENV TZ=Asia/Shanghai

ENTRYPOINT ["/app/app"]
