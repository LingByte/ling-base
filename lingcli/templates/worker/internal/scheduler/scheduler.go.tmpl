package scheduler

import (
	"context"
	"sync"
	"time"

	"{{.Module}}/internal/task"

	"github.com/LingByte/ling-base/common/logger"
	"go.uber.org/zap"
)

type Scheduler struct {
	mu      sync.Mutex
	tasks   []*scheduledTask
	cancel  context.CancelFunc
	running bool
}

type scheduledTask struct {
	name     string
	fn       task.TaskFunc
	interval time.Duration
}

func New() *Scheduler { return &Scheduler{} }

func (s *Scheduler) Register(name string, fn task.TaskFunc, interval time.Duration) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.tasks = append(s.tasks, &scheduledTask{name: name, fn: fn, interval: interval})
	logger.Lg.Info("注册任务",
		zap.String("name", name),
		zap.String("interval", interval.String()))
}

func (s *Scheduler) Start(ctx context.Context) error {
	s.mu.Lock()
	if s.running {
		s.mu.Unlock()
		return nil
	}
	s.running = true
	ctx, s.cancel = context.WithCancel(ctx)
	s.mu.Unlock()

	for _, t := range s.tasks {
		t := t
		go s.runTask(ctx, t)
	}
	return nil
}

func (s *Scheduler) runTask(ctx context.Context, t *scheduledTask) {
	ticker := time.NewTicker(t.interval)
	defer ticker.Stop()

	logger.Lg.Info("任务已启动", zap.String("name", t.name))
	for {
		select {
		case <-ctx.Done():
			logger.Lg.Info("任务已停止", zap.String("name", t.name))
			return
		case <-ticker.C:
			if err := t.fn(ctx); err != nil {
				logger.Lg.Error("任务执行失败",
					zap.String("name", t.name),
					zap.Error(err))
			}
		}
	}
}

func (s *Scheduler) Stop() {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.cancel != nil {
		s.cancel()
	}
	s.running = false
}
