package main

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"time"

	"{{.Module}}/internal/configs"
	"{{.Module}}/internal/handlers"
	{{- if .HasLimiter}}
	localmw "{{.Module}}/internal/middlewares"
	{{- end}}
	"{{.Module}}/internal/models"

	{{- if .HasAPIDocs}}
	"github.com/LingByte/ling-base/apidocs"
	{{- end}}
	"github.com/LingByte/ling-base/bootstrap"
	"github.com/LingByte/ling-base/constants"
	{{- if .HasJWT}}
	"github.com/LingByte/ling-base/common/jwtutil"
	jwtingin "github.com/LingByte/ling-base/common/jwtutil/gin"
	{{- end}}
	{{- if .HasI18n}}
	"github.com/LingByte/ling-base/i18n"
	i18ngin "github.com/LingByte/ling-base/i18n/gin"
	respgin "github.com/LingByte/ling-base/common/response/gin"
	"github.com/LingByte/ling-base/common/response"
	{{- end}}
	"github.com/LingByte/ling-base/logger"
	"github.com/LingByte/ling-base/middleware"
	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
	"gorm.io/gorm"
)

// Version / BuildTime / GitCommit 由 ldflags 注入。
var (
	Version   = "dev"
	BuildTime = "unknown"
	GitCommit = "none"
)

func main() {
	info := &handlers.AppInfo{
		Name:      "{{.ProjectName}}",
		Version:   Version,
		BuildTime: BuildTime,
		GitCommit: GitCommit,
	}

	// 加载配置
	{{- if .IsEnvConfig}}
	cfg, err := configs.Load("configs/.env")
	{{- else}}
	cfg, err := configs.Load("configs/config.yaml")
	{{- end}}
	if err != nil {
		fmt.Fprintf(os.Stderr, "加载配置失败: %v\n", err)
		os.Exit(1)
	}

	// 初始化时区
	logger.InitTimezone(constants.TimezoneShanghai)

	// 初始化日志（zap + lumberjack 轮转 + 脱敏）
	if err := logger.Init(&logger.LogConfig{
		Level:           cfg.Logging.Level,
		Filename:        cfg.Logging.Filename,
		MaxSize:         cfg.Logging.MaxSize,
		MaxAge:          cfg.Logging.MaxAge,
		MaxBackups:      cfg.Logging.MaxBackups,
		Daily:           cfg.Logging.Daily,
		SensitiveFields: cfg.Logging.SensitiveFields,
	}, cfg.App.Environment); err != nil {
		fmt.Fprintf(os.Stderr, "初始化日志失败: %v\n", err)
		os.Exit(1)
	}

	{{- if .HasI18n}}

	// 初始化 i18n（多语言翻译，配置来自 configs/config.yaml）
	supportedLocales := make([]i18n.Locale, len(cfg.I18n.SupportedLocales))
	for i, loc := range cfg.I18n.SupportedLocales {
		supportedLocales[i] = i18n.Locale(loc)
	}
	i18nManager := i18n.NewManager(&i18n.Config{
		DefaultLocale:    i18n.Locale(cfg.I18n.DefaultLocale),
		SupportedLocales: supportedLocales,
		FallbackLocale:   i18n.Locale(cfg.I18n.FallbackLocale),
		TranslationsPath: cfg.I18n.TranslationsPath,
	})
	// 设置 response 包的 i18n resolver，让统一响应封装自动翻译消息
	// 实际 locale 由 i18ngin.Middleware 在请求时检测，这里用默认 locale 作为 fallback
	respgin.Resolver = response.ResolverFunc(func(key string, args ...any) string {
		return i18nManager.T(i18nManager.GetDefaultLocale(), key, args...)
	})
	{{- end}}

	// 创建 bootstrap 应用
	appOpts := []bootstrap.Option{
		bootstrap.WithProfile(cfg.App.Environment),
		bootstrap.WithBannerText(info.Name),
		bootstrap.WithShutdownTimeout(15 * time.Second),
	}

	// 数据库初始化 + 迁移
	var db *gorm.DB
	if cfg.Database.DSN != "" {
		db, err = configs.InitDB(cfg.Database)
		if err != nil {
			logger.Lg.Error("数据库初始化失败", zap.Error(err))
			os.Exit(1)
		}
		// dev/test: AutoMigrate; prod: 手动 SQL 迁移
		if cfg.App.Environment == "dev" || cfg.App.Environment == "test" {
			appOpts = append(appOpts, bootstrap.WithAutoMigrate(db, &models.User{}))
		}
	}

	{{- if .HasCircuitBreaker}}

	// 初始化超时+熔断管理器（ling-base/middleware）
	recoveryTimeout, _ := time.ParseDuration(cfg.CircuitBreaker.RecoveryTimeout)
	middleware.InitTimeoutCircuitManager(
		middleware.TimeoutConfig{
			DefaultTimeout:   30 * time.Second,
			FallbackResponse: map[string]interface{}{"error": "service_unavailable", "message": "服务暂时不可用"},
		},
		middleware.CircuitBreakerConfig{
			FailureThreshold:      cfg.CircuitBreaker.FailureThreshold,
			SuccessThreshold:      3,
			OpenTimeout:           recoveryTimeout,
			MaxConcurrentRequests: cfg.CircuitBreaker.MinRequests,
		},
		true,                        // enableTimeout
		cfg.CircuitBreaker.Enabled,  // enableCircuitBreaker
	)
	{{- end}}

	{{- if .HasJWT}}

	// 初始化 JWT 鉴权（ling-base/common/jwtutil）
	accessTTL, _ := time.ParseDuration(cfg.JWT.AccessTTL)
	refreshTTL, _ := time.ParseDuration(cfg.JWT.RefreshTTL)
	jwtAuth, err := jwtutil.New(jwtutil.Config{
		Secret:     []byte(cfg.JWT.Secret),
		Issuer:     cfg.JWT.Issuer,
		AccessTTL:  accessTTL,
		RefreshTTL: refreshTTL,
	})
	if err != nil {
		fmt.Fprintf(os.Stderr, "初始化 JWT 失败: %v\n", err)
		os.Exit(1)
	}
	info.JWTAuth = jwtAuth
	{{- end}}

	app := bootstrap.New(info.Name, appOpts...)

	// 注册 HTTP 服务器为生命周期组件
	app.Register("http-server", &httpServerComponent{
		info: info,
		cfg:  cfg,
		db:   db,
		{{- if .HasJWT}}
		jwtAuth: jwtAuth,
		{{- end}}
		{{- if .HasI18n}}
		i18nManager: i18nManager,
		{{- end}}
	})

	// 启动（阻塞直到收到关闭信号）
	if err := app.Run(); err != nil {
		logger.Lg.Error("应用启动失败", zap.Error(err))
		os.Exit(1)
	}
}

// ──────────────────────────────────────────────
// HTTP 服务器生命周期组件
// ──────────────────────────────────────────────

type httpServerComponent struct {
	info   *handlers.AppInfo
	cfg    *configs.Config
	db     *gorm.DB
	server *http.Server
	{{- if .HasJWT}}
	jwtAuth *jwtutil.Auth
	{{- end}}
	{{- if .HasI18n}}
	i18nManager *i18n.Manager
	{{- end}}
}

func (c *httpServerComponent) Start(ctx context.Context) error {
	// 生产环境用 Release 模式
	if c.cfg.App.Environment == "prod" {
		gin.SetMode(gin.ReleaseMode)
	}

	r := gin.New()

	// 全局中间件（ling-base/middleware 库）
	// RequestID → Logger → PanicRecovery → CORS（顺序重要）
	r.Use(middleware.RequestIDMiddleware())
	r.Use(middleware.LoggerMiddleware(logger.Lg))
	r.Use(middleware.PanicRecovery())
	r.Use(middleware.CORS())
	{{- if .HasI18n}}
	// i18n 中间件（从 Accept-Language / query param / cookie 检测语言）
	r.Use(i18ngin.Middleware(c.i18nManager))
	{{- end}}
	{{- if .HasLimiter}}
	r.Use(localmw.RateLimit(c.cfg.RateLimit))
	{{- end}}
	{{- if .HasCircuitBreaker}}
	r.Use(middleware.CircuitBreakerMiddleware())
	{{- end}}
	{{- if .HasJWT}}
	// JWT 鉴权中间件（ling-base/common/jwtutil/gin，公开路径自动跳过）
	if c.jwtAuth != nil {
		r.Use(jwtingin.Middleware(c.jwtAuth, jwtingin.WithPublicPaths(
			"/health", "/live", "/ready", "/api/v1/version",
			"/api/v1/auth/login", "/api/v1/auth/refresh",
			"/docs", "/openapi",
		)))
	}
	{{- end}}

	{{- if .HasAPIDocs}}
	// 先挂载 apidocs，拿到 huma.API（用于注册带 OpenAPI 文档的路由）
	docsEnabled := c.cfg.Docs.Enabled
	api := apidocs.Mount(r, apidocs.Options{
		Title:       c.info.Name + " API",
		Version:     c.info.Version,
		Description: "{{.ProjectName}} RESTful API 文档",
		DocsPath:    c.cfg.Docs.Path,
		DarkMode:    c.cfg.Docs.DarkMode,
		EnabledFunc: func() bool { return docsEnabled },
	})

	// 创建 Handlers 并注册路由（humax.Group: Gin 执行 + OpenAPI 文档）
	h := handlers.New(c.cfg, *c.info, c.db)
	h.Register(r, api)
	{{- else}}
	// 创建 Handlers 并注册路由（纯 Gin）
	h := handlers.New(c.cfg, *c.info, c.db)
	h.Register(r)
	{{- end}}

	c.server = &http.Server{
		Addr:         fmt.Sprintf(":%d", c.cfg.Server.Port),
		Handler:      r,
		ReadTimeout:  c.cfg.Server.ReadTimeout,
		WriteTimeout: c.cfg.Server.WriteTimeout,
		IdleTimeout:  c.cfg.Server.IdleTimeout,
	}

	go func() {
		logger.Lg.Info("HTTP 服务已启动",
			zap.String("addr", c.server.Addr),
			zap.String("version", c.info.Version))
		if err := c.server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			logger.Lg.Error("HTTP 服务异常", zap.Error(err))
		}
	}()

	return nil
}

func (c *httpServerComponent) Stop(ctx context.Context) error {
	logger.Lg.Info("正在关闭 HTTP 服务...")
	return c.server.Shutdown(ctx)
}

func (c *httpServerComponent) IsRunning() bool {
	return c.server != nil
}
