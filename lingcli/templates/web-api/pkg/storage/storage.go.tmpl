// Package storage 封装 ling-base/stores 对象存储能力,提供包级单例。
//
// 使用方式:
//
//	// main.go 启动时初始化
//	pkgstorage.Init(cfg.Storage)
//
//	// handler / service 中直接调用
//	pkgstorage.Write("avatars/photo.jpg", reader)
//	url := pkgstorage.PublicURL("avatars/photo.jpg")
//
// 切换云存储后端(S3/OSS/COS/MinIO 等):
//  1. go get 对应驱动模块,如 go get github.com/LingByte/ling-base/stores/s3
//  2. 在 Init() 的 switch 中加入对应 case
//  3. 修改 configs/config.yaml 的 storage.driver
package storage

import (
	"fmt"
	"io"
	"os"

	"github.com/LingByte/ling-base/stores"
	"github.com/LingByte/ling-base/stores/local"
)

// 全局单例(包级变量)。Init 后可通过 Storage 直接调用。
var (
	// Store 是当前生效的对象存储实例。未 Init 前为 nil。
	Store stores.Store

	// MaxFileSize 单文件大小上限(字节,0 = 不限制)。
	MaxFileSize int64

	// PublicURLBase 公网访问基址(留空则用 Store.PublicURL() 默认值)。
	PublicURLBase string
)

// Init 根据配置初始化对象存储单例。
// 默认 local 后端(本地文件系统,零云 SDK 依赖)。
// 切换 driver 时需要额外 go get 对应模块,并在 switch 中加入 case。
func Init(driver, root, region, endpoint, accessKey, secretKey, publicURLBase string, maxFileSize int64) error {
	switch driver {
	case "local", "":
		Store = local.New(local.Config{
			Root:       root,
			NewDirPerm: 0755,
		})
	// ── 以下后端需要额外 go get 对应模块 ──
	// case "s3":
	//     Store = s3.New(s3.Config{Bucket: root, Region: region, AccessKey: accessKey, SecretKey: secretKey, Endpoint: endpoint})
	// case "oss":
	//     Store = oss.New(oss.Config{Bucket: root, Region: region, AccessKey: accessKey, SecretKey: secretKey})
	// case "cos":
	//     Store = cos.New(cos.Config{Bucket: root, Region: region, SecretID: accessKey, SecretKey: secretKey})
	// case "minio":
	//     Store = minio.New(minio.Config{Bucket: root, Endpoint: endpoint, AccessKey: accessKey, SecretKey: secretKey})
	default:
		return fmt.Errorf("不支持的存储驱动: %s(需先 go get 对应模块)", driver)
	}

	MaxFileSize = maxFileSize
	PublicURLBase = publicURLBase
	return nil
}

// ──────────────────────────────────────────────
// 便捷方法 — 直接操作全局 Store
// ──────────────────────────────────────────────

// Write 存储 reader 的内容到 key。
func Write(key string, r io.Reader) error {
	if Store == nil {
		return fmt.Errorf("storage 未初始化,请先调用 Init()")
	}
	return Store.Write(key, r)
}

// Read 返回 key 对应对象的 reader 和大小。
func Read(key string) (io.ReadCloser, int64, error) {
	if Store == nil {
		return nil, 0, fmt.Errorf("storage 未初始化,请先调用 Init()")
	}
	return Store.Read(key)
}

// Delete 删除 key 对应的对象(不存在不报错)。
func Delete(key string) error {
	if Store == nil {
		return fmt.Errorf("storage 未初始化,请先调用 Init()")
	}
	return Store.Delete(key)
}

// Exists 检查 key 是否存在。
func Exists(key string) (bool, error) {
	if Store == nil {
		return false, fmt.Errorf("storage 未初始化,请先调用 Init()")
	}
	return Store.Exists(key)
}

// PublicURL 返回 key 的公开访问 URL。
// 若配置了 PublicURLBase,则拼接为 PublicURLBase/key;否则用 Store.PublicURL()。
func PublicURL(key string) string {
	if Store == nil {
		return ""
	}
	if PublicURLBase != "" {
		return PublicURLBase + "/" + key
	}
	return Store.PublicURL(key)
}

// CheckFileSize 校验文件大小是否在限制内。
// maxSize 为 0 表示不限制。
func CheckFileSize(size int64) error {
	if MaxFileSize > 0 && size > MaxFileSize {
		return fmt.Errorf("文件大小 %d 超过限制 %d", size, MaxFileSize)
	}
	return nil
}

// Close 释放资源(目前 local 后端无需清理,保留以兼容云存储后端)。
func Close() error {
	// local 后端无需 close;云存储后端如有 Close 方法可在此调用
	_ = os.Stdout // 避免 import 未使用告警(当未集成云后端时)
	return nil
}
