// Package fallback 提供服务降级助手函数。
//
// 当熔断器打开(circuitbreaker.ErrCircuitOpen)、限流(limiter.ErrLimited)
// 或远程调用失败时,可用本包返回降级响应(缓存数据/默认值/友好提示),
// 而非直接向客户端返回 5xx 错误。
//
// 使用方式:
//
//	// main.go 启动时初始化
//	pkgfallback.Init(cfg.Fallback)
//
//	// handler / service 中
//	val, err := callRemote(ctx)
//	if err != nil {
//	    if pkgfallback.ShouldDegrade(err) {
//	        return pkgfallback.JSON(c, "service_degraded", "服务降级,返回默认值")
//	    }
//	    return err
//	}
//
//	// 或返回缓存降级数据
//	cached, _ := pkgcache.Get(ctx, "user:123")
//	return pkgfallback.Data(c, cached)
package fallback

import (
	"errors"
	"net/http"

	"github.com/LingByte/ling-base/common/circuitbreaker"
	"github.com/gin-gonic/gin"
)

// 全局配置。
var (
	// Enabled 是否启用降级(全局开关)。
	Enabled bool

	// DefaultMessage 默认降级提示消息。
	DefaultMessage string

	// DefaultCode 默认降级 HTTP 状态码。
	DefaultCode int
)

// Init 根据配置初始化降级单例。
func Init(enabled bool, defaultMessage string, defaultCode int) {
	Enabled = enabled
	DefaultMessage = defaultMessage
	if DefaultMessage == "" {
		DefaultMessage = "服务暂时不可用,请稍后再试"
	}
	DefaultCode = defaultCode
	if DefaultCode == 0 {
		DefaultCode = http.StatusServiceUnavailable // 503
	}
}

// ShouldDegrade 判断错误是否应触发降级。
// 匹配熔断器打开、限流等可降级错误。
func ShouldDegrade(err error) bool {
	if !Enabled || err == nil {
		return false
	}
	if errors.Is(err, circuitbreaker.ErrCircuitOpen) {
		return true
	}
	if errors.Is(err, circuitbreaker.ErrTooManyRequests) {
		return true
	}
	// 可扩展: limiter.ErrLimited, timeout 等
	return false
}

// JSON 返回降级 JSON 响应。
// code 是业务错误码字符串,message 是提示消息。
func JSON(c *gin.Context, code, message string) {
	if message == "" {
		message = DefaultMessage
	}
	c.JSON(DefaultCode, gin.H{
		"code":    code,
		"message": message,
		"fallback": true,
	})
	c.Abort()
}

// Data 返回降级数据(如缓存内容)。
// HTTP 状态码为 200(因为返回了有效数据),但标记 fallback=true。
func Data(c *gin.Context, data interface{}) {
	c.JSON(http.StatusOK, gin.H{
		"code":     0,
		"data":     data,
		"fallback": true,
		"message":  "降级响应(返回缓存/默认数据)",
	})
	c.Abort()
}

// Message 返回默认降级提示(用 DefaultMessage 和 DefaultCode)。
func Message(c *gin.Context) {
	JSON(c, "service_degraded", DefaultMessage)
}
