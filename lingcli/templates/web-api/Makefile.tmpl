# {{.ProjectName}} Makefile

APP := {{.ProjectName}}
VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_TIME := $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
LDFLAGS := -X main.Version=$(VERSION) -X main.BuildTime=$(shell git rev-parse --short HEAD 2>/dev/null || echo "none")

.PHONY: all build run test vet fmt fmt-check clean docker-build docker-up docker-down help

all: build

## build: 编译项目
build:
	go build -ldflags "$(LDFLAGS)" -o bin/$(APP) ./cmd/...

## run: 本地运行
run:
	go run ./cmd/... -config configs/config.yaml

## test: 运行测试
test:
	go test -v -race -count=1 ./...

## test-cover: 测试覆盖率
test-cover:
	go test -race -coverprofile=coverage.txt -covermode=atomic ./...
	go tool cover -func=coverage.txt

## vet: 静态检查
vet:
	go vet ./...

## fmt: 格式化代码
fmt:
	go fmt ./...

## fmt-check: 检查格式化
fmt-check:
	@test -z "$$(gofmt -l .)" || (echo "需要运行 make fmt" && exit 1)

## clean: 清理构建产物
clean:
	rm -rf bin/ dist/ coverage.txt data/

## docker-build: 构建 Docker 镜像
docker-build:
	docker build -t $(APP):$(VERSION) .

## docker-up: 启动 Docker Compose
docker-up:
	docker compose up -d

## docker-down: 停止 Docker Compose
docker-down:
	docker compose down

## help: 显示帮助
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/## //'
