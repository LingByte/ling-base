package auth

import (
	"net/http"
	"strings"
	"time"

	"{{.Module}}/internal/configs"

	"github.com/LingByte/ling-base/common/jwtutil"
	"github.com/gin-gonic/gin"
)

// Auth 封装 jwtutil.Auth，提供 JWT 鉴权能力。
type Auth struct {
	manager *jwtutil.Auth
	cfg     configs.JWTConfig
}

// New 根据 JWT 配置创建鉴权管理器。
func New(cfg configs.JWTConfig, accessTTL, refreshTTL time.Duration) (*Auth, error) {
	if !cfg.Enabled {
		return &Auth{cfg: cfg}, nil
	}

	manager, err := jwtutil.New(jwtutil.Config{
		Secret:     []byte(cfg.Secret),
		Issuer:     cfg.Issuer,
		AccessTTL:  accessTTL,
		RefreshTTL: refreshTTL,
	})
	if err != nil {
		return nil, err
	}

	return &Auth{manager: manager, cfg: cfg}, nil
}

// Enabled 返回 JWT 是否启用。
func (a *Auth) Enabled() bool {
	return a.cfg.Enabled && a.manager != nil
}

// Login 为指定用户签发 token 对。
func (a *Auth) Login(userID string, roles ...string) (*jwtutil.TokenPair, error) {
	return a.manager.Login(userID, jwtutil.WithRoles(roles...))
}

// Verify 验证 access token 并返回 claims。
func (a *Auth) Verify(token string) (*jwtutil.Claims, error) {
	return a.manager.Verify(token)
}

// Refresh 使用 refresh token 签发新的 token 对。
func (a *Auth) Refresh(refreshToken string) (*jwtutil.TokenPair, error) {
	return a.manager.Refresh(refreshToken)
}

// GinMiddleware 返回 Gin JWT 鉴权中间件。
// 从 Authorization: Bearer <token> 提取 token，验证后将 claims 存入 context。
func (a *Auth) GinMiddleware() gin.HandlerFunc {
	if !a.Enabled() {
		// 未启用时直接放行
		return func(c *gin.Context) { c.Next() }
	}

	return func(c *gin.Context) {
		// 跳过不需要鉴权的路径
		path := c.Request.URL.Path
		if isPublicPath(path) {
			c.Next()
			return
		}

		authHeader := c.GetHeader("Authorization")
		token, err := jwtutil.ExtractBearer(authHeader)
		if err != nil {
			c.JSON(http.StatusUnauthorized, gin.H{
				"error":   "unauthorized",
				"message": "缺少有效的 Authorization 头",
			})
			c.Abort()
			return
		}

		claims, err := a.Verify(token)
		if err != nil {
			c.JSON(http.StatusUnauthorized, gin.H{
				"error":   "invalid_token",
				"message": "token 无效或已过期",
			})
			c.Abort()
			return
		}

		// 将 claims 存入 context 供后续 handler 使用
		c.Set("claims", claims)
		c.Set("userID", claims.Subject)
		c.Next()
	}
}

// RequireRole 返回一个要求指定角色的中间件。
// 必须在 GinMiddleware 之后使用。
func (a *Auth) RequireRole(role string) gin.HandlerFunc {
	return func(c *gin.Context) {
		claimsVal, exists := c.Get("claims")
		if !exists {
			c.JSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
			c.Abort()
			return
		}
		claims, ok := claimsVal.(*jwtutil.Claims)
		if !ok || !claims.HasRole(role) {
			c.JSON(http.StatusForbidden, gin.H{
				"error":   "forbidden",
				"message": "权限不足",
			})
			c.Abort()
			return
		}
		c.Next()
	}
}

// isPublicPath 判断路径是否为公开路径（不需要鉴权）。
func isPublicPath(path string) bool {
	publicPrefixes := []string{
		"/health",
		"/api/v1/version",
		"/api/v1/auth/login",
		"/api/v1/auth/refresh",
		"/docs",
		"/openapi",
	}
	for _, prefix := range publicPrefixes {
		if strings.HasPrefix(path, prefix) {
			return true
		}
	}
	return false
}
