package handler

import (
	"net/http"
	"time"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/model"
	"{{.Module}}/internal/service"
	{{- if .HasJWT}}
	"{{.Module}}/internal/auth"
	{{- end}}
	{{- if .HasAPIDocs}}
	"context"

	"github.com/danielgtaylor/huma/v2"
	{{- else}}
	"strconv"

	"github.com/gin-gonic/gin"
	{{- end}}
)

// AppInfo 应用信息（供 Version handler 使用）。
type AppInfo struct {
	Name      string
	Version   string
	BuildTime string
	GitCommit string
	{{- if .HasJWT}}
	JWTAuth  *auth.Auth
	{{- end}}
}

// Handler HTTP 请求处理器。
type Handler struct {
	cfg       *config.Config
	info      AppInfo
	startTime time.Time
	userSvc   *service.UserService
	{{- if .HasJWT}}
	jwtAuth   *auth.Auth
	{{- end}}
}

// New 创建处理器。
func New(cfg *config.Config, info AppInfo) *Handler {
	return &Handler{
		cfg:       cfg,
		info:      info,
		startTime: time.Now(),
		{{- if .HasJWT}}
		jwtAuth:   info.JWTAuth,
		{{- end}}
	}
}

// SetUserService 注入用户服务（由 app.go 调用）。
func (h *Handler) SetUserService(svc *service.UserService) {
	h.userSvc = svc
}

{{- if .HasAPIDocs}}

// ──────────────────────────────────────────────
// Huma 注册（路由 + OpenAPI 文档）
// ──────────────────────────────────────────────

// RegisterRoutes 通过 Huma 注册所有路由（同时生成 OpenAPI 文档）。
func RegisterRoutes(api huma.API, cfg *config.Config, info AppInfo) *Handler {
	h := New(cfg, info)

	// ── 系统端点 ──

	huma.Register(api, huma.Operation{
		OperationID: "get-health",
		Method:      http.MethodGet,
		Path:        "/health",
		Summary:     "健康检查",
		Description: "综合健康状态，包含 uptime、环境、版本。",
		Tags:        []string{"系统"},
	}, func(ctx context.Context, _ *struct{}) (*HealthOutput, error) {
		return &HealthOutput{
			Body: HealthBody{
				Status:  "healthy",
				Uptime:  time.Since(h.startTime).String(),
				Env:     h.cfg.App.Environment,
				Version: h.info.Version,
			},
		}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-live",
		Method:      http.MethodGet,
		Path:        "/live",
		Summary:     "存活探针",
		Description: "K8s liveness probe，进程能响应即 200。",
		Tags:        []string{"系统"},
	}, func(ctx context.Context, _ *struct{}) (*LiveOutput, error) {
		return &LiveOutput{Body: LiveBody{Status: "alive"}}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-ready",
		Method:      http.MethodGet,
		Path:        "/ready",
		Summary:     "就绪探针",
		Description: "K8s readiness probe，检查依赖是否就绪。",
		Tags:        []string{"系统"},
	}, func(ctx context.Context, _ *struct{}) (*ReadyOutput, error) {
		return &ReadyOutput{Body: ReadyBody{Status: "ready"}}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-version",
		Method:      http.MethodGet,
		Path:        "/api/v1/version",
		Summary:     "版本信息",
		Tags:        []string{"系统"},
	}, func(ctx context.Context, _ *struct{}) (*VersionOutput, error) {
		return &VersionOutput{Body: VersionBody{
			Name: h.info.Name, Version: h.info.Version,
			BuildTime: h.info.BuildTime, GitCommit: h.info.GitCommit,
		}}, nil
	})

	// ── 用户 CRUD ──

	huma.Register(api, huma.Operation{
		OperationID: "list-users",
		Method:      http.MethodGet,
		Path:        "/api/v1/users",
		Summary:     "用户列表",
		Description: "分页查询用户列表。",
		Tags:        []string{"用户"},
	}, func(ctx context.Context, input *ListUsersInput) (*ListUsersOutput, error) {
		page := input.Query.Page
		size := input.Query.Size
		if h.userSvc == nil {
			users := []model.User{
				{ID: 1, Name: "Alice", Email: "alice@example.com", CreatedAt: time.Now()},
				{ID: 2, Name: "Bob", Email: "bob@example.com", CreatedAt: time.Now()},
			}
			return &ListUsersOutput{Body: ListUsersBody{
				Users: users, Total: int64(len(users)), Page: page, Size: size,
			}}, nil
		}
		users, total, err := h.userSvc.List(ctx, page, size)
		if err != nil {
			return nil, huma.Error500InternalServerError("查询失败")
		}
		return &ListUsersOutput{Body: ListUsersBody{
			Users: users, Total: total, Page: page, Size: size,
		}}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-user",
		Method:      http.MethodGet,
		Path:        "/api/v1/users/{id}",
		Summary:     "查询用户",
		Tags:        []string{"用户"},
	}, func(ctx context.Context, input *GetUserInput) (*GetUserOutput, error) {
		if h.userSvc == nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		user, err := h.userSvc.Get(ctx, input.ID)
		if err != nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		return &GetUserOutput{Body: *user}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID:   "create-user",
		Method:        http.MethodPost,
		Path:          "/api/v1/users",
		Summary:       "创建用户",
		Tags:          []string{"用户"},
		DefaultStatus: http.StatusCreated,
	}, func(ctx context.Context, input *CreateUserInput) (*CreateUserOutput, error) {
		user := model.User{
			Name:  input.Body.Name,
			Email: input.Body.Email,
			Phone: input.Body.Phone,
		}
		if h.userSvc == nil {
			user.ID = time.Now().Unix()
			user.CreatedAt = time.Now()
			return &CreateUserOutput{Body: user}, nil
		}
		if err := h.userSvc.Create(ctx, &user); err != nil {
			return nil, huma.Error500InternalServerError("创建失败")
		}
		return &CreateUserOutput{Body: user}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "update-user",
		Method:      http.MethodPut,
		Path:        "/api/v1/users/{id}",
		Summary:     "更新用户",
		Tags:        []string{"用户"},
	}, func(ctx context.Context, input *UpdateUserInput) (*UpdateUserOutput, error) {
		if h.userSvc == nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		user, err := h.userSvc.Get(ctx, input.ID)
		if err != nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		if input.Body.Name != nil {
			user.Name = *input.Body.Name
		}
		if input.Body.Email != nil {
			user.Email = *input.Body.Email
		}
		if input.Body.Phone != nil {
			user.Phone = *input.Body.Phone
		}
		if err := h.userSvc.Update(ctx, user); err != nil {
			return nil, huma.Error500InternalServerError("更新失败")
		}
		return &UpdateUserOutput{Body: *user}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID:   "delete-user",
		Method:        http.MethodDelete,
		Path:          "/api/v1/users/{id}",
		Summary:       "删除用户",
		Tags:          []string{"用户"},
		DefaultStatus: http.StatusNoContent,
	}, func(ctx context.Context, input *DeleteUserInput) (*struct{}, error) {
		if h.userSvc == nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		if err := h.userSvc.Delete(ctx, input.ID); err != nil {
			return nil, huma.Error404NotFound("用户不存在")
		}
		return nil, nil
	})

	{{- if .HasJWT}}

	// ── JWT 鉴权 ──

	huma.Register(api, huma.Operation{
		OperationID: "auth-login",
		Method:      http.MethodPost,
		Path:        "/api/v1/auth/login",
		Summary:     "用户登录",
		Description: "验证凭据并签发 JWT access/refresh token 对。",
		Tags:        []string{"鉴权"},
	}, func(ctx context.Context, input *LoginInput) (*LoginOutput, error) {
		if h.jwtAuth == nil || !h.jwtAuth.Enabled() {
			return nil, huma.Error503ServiceUnavailable("JWT 鉴权未启用")
		}
		pair, err := h.jwtAuth.Login(input.Body.Username, "user")
		if err != nil {
			return nil, huma.Error500InternalServerError("签发 token 失败")
		}
		return &LoginOutput{Body: TokenBody{
			AccessToken: pair.AccessToken, RefreshToken: pair.RefreshToken,
			ExpiresIn: pair.ExpiresIn, TokenType: pair.TokenType,
		}}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "auth-refresh",
		Method:      http.MethodPost,
		Path:        "/api/v1/auth/refresh",
		Summary:     "刷新 token",
		Description: "用 refresh token 换取新的 access/refresh token 对。",
		Tags:        []string{"鉴权"},
	}, func(ctx context.Context, input *RefreshInput) (*RefreshOutput, error) {
		if h.jwtAuth == nil || !h.jwtAuth.Enabled() {
			return nil, huma.Error503ServiceUnavailable("JWT 鉴权未启用")
		}
		pair, err := h.jwtAuth.Refresh(input.Body.RefreshToken)
		if err != nil {
			return nil, huma.Error401Unauthorized("refresh token 无效或已过期")
		}
		return &RefreshOutput{Body: TokenBody{
			AccessToken: pair.AccessToken, RefreshToken: pair.RefreshToken,
			ExpiresIn: pair.ExpiresIn, TokenType: pair.TokenType,
		}}, nil
	})
	{{- end}}

	return h
}

// ── Huma 输入/输出类型 ──

type HealthBody struct {
	Status  string `json:"status" example:"healthy"`
	Uptime  string `json:"uptime"`
	Env     string `json:"env"`
	Version string `json:"version"`
}
type HealthOutput struct{ Body HealthBody }

type LiveBody struct {
	Status string `json:"status" example:"alive"`
}
type LiveOutput struct{ Body LiveBody }

type ReadyBody struct {
	Status string `json:"status" example:"ready"`
}
type ReadyOutput struct{ Body ReadyBody }

type VersionBody struct {
	Name      string `json:"name"`
	Version   string `json:"version"`
	BuildTime string `json:"buildTime"`
	GitCommit string `json:"gitCommit"`
}
type VersionOutput struct{ Body VersionBody }

type ListUsersInput struct {
	Query struct {
		Page int `query:"page" default:"1" minimum:"1"`
		Size int `query:"size" default:"20" minimum:"1" maximum:"100"`
	}
}
type ListUsersBody struct {
	Users []model.User `json:"users"`
	Total int64        `json:"total"`
	Page  int          `json:"page"`
	Size  int          `json:"size"`
}
type ListUsersOutput struct{ Body ListUsersBody }

type GetUserInput struct {
	ID int64 `path:"id"`
}
type GetUserOutput struct{ Body model.User }

type CreateUserInput struct {
	Body struct {
		Name  string `json:"name" minLength:"1" maxLength:"100"`
		Email string `json:"email" format:"email"`
		Phone string `json:"phone,omitempty" maxLength:"20"`
	}
}
type CreateUserOutput struct{ Body model.User }

type UpdateUserInput struct {
	ID   int64 `path:"id"`
	Body struct {
		Name  *string `json:"name,omitempty" minLength:"1" maxLength:"100"`
		Email *string `json:"email,omitempty" format:"email"`
		Phone *string `json:"phone,omitempty" maxLength:"20"`
	}
}
type UpdateUserOutput struct{ Body model.User }

type DeleteUserInput struct {
	ID int64 `path:"id"`
}

{{- if .HasJWT}}

type LoginInput struct {
	Body struct {
		Username string `json:"username" minLength:"1"`
		Password string `json:"password" minLength:"1"`
	}
}
type TokenBody struct {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresIn    int64  `json:"expires_in"`
	TokenType    string `json:"token_type"`
}
type LoginOutput struct{ Body TokenBody }

type RefreshInput struct {
	Body struct {
		RefreshToken string `json:"refresh_token" minLength:"1"`
	}
}
type RefreshOutput struct{ Body TokenBody }
{{- end}}

{{- else}}

// ──────────────────────────────────────────────
// Gin 注册（无 apidocs 时使用）
// ──────────────────────────────────────────────

// RegisterRoutes 通过 Gin 注册所有路由。
func RegisterRoutes(r *gin.Engine, cfg *config.Config, info AppInfo) *Handler {
	h := New(cfg, info)

	// 健康检查（公开）—— 分级探针
	r.GET("/health", h.Health)
	r.GET("/live", h.Liveness)
	r.GET("/ready", h.Readiness)
	r.GET("/api/v1/version", h.Version)

	{{- if .HasJWT}}
	// 鉴权相关路由（公开）
	authGroup := r.Group("/api/v1/auth")
	{
		authGroup.POST("/login", h.Login)
		authGroup.POST("/refresh", h.Refresh)
	}
	{{- end}}

	// 用户路由
	users := r.Group("/api/v1/users")
	{
		users.GET("", h.ListUsers)
		users.GET("/:id", h.GetUser)
		users.POST("", h.CreateUser)
		users.PUT("/:id", h.UpdateUser)
		users.DELETE("/:id", h.DeleteUser)
	}

	return h
}

// Health 综合健康检查。
func (h *Handler) Health(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{
		"status":  "healthy",
		"uptime":  time.Since(h.startTime).String(),
		"env":     h.cfg.App.Environment,
		"version": h.info.Version,
	})
}

// Liveness 存活探针（K8s liveness probe）。
func (h *Handler) Liveness(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"status": "alive"})
}

// Readiness 就绪探针（K8s readiness probe）。
func (h *Handler) Readiness(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"status": "ready"})
}

// Version 版本信息。
func (h *Handler) Version(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{
		"name":      h.info.Name,
		"version":   h.info.Version,
		"buildTime": h.info.BuildTime,
		"gitCommit": h.info.GitCommit,
	})
}

// ── 用户 CRUD ──

func (h *Handler) ListUsers(c *gin.Context) {
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	size, _ := strconv.Atoi(c.DefaultQuery("size", "20"))
	if h.userSvc == nil {
		users := []model.User{
			{ID: 1, Name: "Alice", Email: "alice@example.com", CreatedAt: time.Now()},
			{ID: 2, Name: "Bob", Email: "bob@example.com", CreatedAt: time.Now()},
		}
		c.JSON(http.StatusOK, gin.H{"users": users, "total": len(users), "page": page, "size": size})
		return
	}
	users, total, err := h.userSvc.List(c.Request.Context(), page, size)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "查询失败"})
		return
	}
	c.JSON(http.StatusOK, gin.H{"users": users, "total": total, "page": page, "size": size})
}

func (h *Handler) GetUser(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的用户 ID"})
		return
	}
	if h.userSvc == nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	user, err := h.userSvc.Get(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	c.JSON(http.StatusOK, user)
}

type createUserRequest struct {
	Name  string `json:"name" binding:"required,min=1,max=100"`
	Email string `json:"email" binding:"required,email"`
	Phone string `json:"phone" binding:"omitempty,max=20"`
}

func (h *Handler) CreateUser(c *gin.Context) {
	var req createUserRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的请求体", "detail": err.Error()})
		return
	}
	user := model.User{Name: req.Name, Email: req.Email, Phone: req.Phone}
	if h.userSvc == nil {
		user.ID = time.Now().Unix()
		user.CreatedAt = time.Now()
		c.JSON(http.StatusCreated, user)
		return
	}
	if err := h.userSvc.Create(c.Request.Context(), &user); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "创建失败"})
		return
	}
	c.JSON(http.StatusCreated, user)
}

type updateUserRequest struct {
	Name  *string `json:"name" binding:"omitempty,min=1,max=100"`
	Email *string `json:"email" binding:"omitempty,email"`
	Phone *string `json:"phone" binding:"omitempty,max=20"`
}

func (h *Handler) UpdateUser(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的用户 ID"})
		return
	}
	var req updateUserRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的请求体", "detail": err.Error()})
		return
	}
	if h.userSvc == nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	user, err := h.userSvc.Get(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	if req.Name != nil {
		user.Name = *req.Name
	}
	if req.Email != nil {
		user.Email = *req.Email
	}
	if req.Phone != nil {
		user.Phone = *req.Phone
	}
	if err := h.userSvc.Update(c.Request.Context(), user); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "更新失败"})
		return
	}
	c.JSON(http.StatusOK, user)
}

func (h *Handler) DeleteUser(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的用户 ID"})
		return
	}
	if h.userSvc == nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	if err := h.userSvc.Delete(c.Request.Context(), id); err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "用户不存在"})
		return
	}
	c.Status(http.StatusNoContent)
}

{{- if .HasJWT}}

// ── JWT 鉴权 ──

type loginRequest struct {
	Username string `json:"username" binding:"required"`
	Password string `json:"password" binding:"required"`
}

func (h *Handler) Login(c *gin.Context) {
	if h.jwtAuth == nil || !h.jwtAuth.Enabled() {
		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "JWT 鉴权未启用"})
		return
	}
	var req loginRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的请求体"})
		return
	}
	pair, err := h.jwtAuth.Login(req.Username, "user")
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "签发 token 失败"})
		return
	}
	c.JSON(http.StatusOK, gin.H{
		"access_token":  pair.AccessToken,
		"refresh_token": pair.RefreshToken,
		"expires_in":    pair.ExpiresIn,
		"token_type":    pair.TokenType,
	})
}

type refreshRequest struct {
	RefreshToken string `json:"refresh_token" binding:"required"`
}

func (h *Handler) Refresh(c *gin.Context) {
	if h.jwtAuth == nil || !h.jwtAuth.Enabled() {
		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "JWT 鉴权未启用"})
		return
	}
	var req refreshRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "无效的请求体"})
		return
	}
	pair, err := h.jwtAuth.Refresh(req.RefreshToken)
	if err != nil {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "refresh token 无效或已过期"})
		return
	}
	c.JSON(http.StatusOK, gin.H{
		"access_token":  pair.AccessToken,
		"refresh_token": pair.RefreshToken,
		"expires_in":    pair.ExpiresIn,
		"token_type":    pair.TokenType,
	})
}
{{- end}}

{{- end}}
