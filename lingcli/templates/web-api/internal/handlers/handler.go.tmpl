// ListUsers 分页查询用户列表。
func (h *Handlers) ListUsers(c *gin.Context) {
	var req types.PageRequest
	if err := c.ShouldBindQuery(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	page, size := req.Normalize()

	if h.db == nil {
		users := []models.User{
			{ID: 1, Name: "Alice", Email: "alice@example.com", CreatedAt: time.Now()},
			{ID: 2, Name: "Bob", Email: "bob@example.com", CreatedAt: time.Now()},
		}
		respgin.Success(c, response.NewPage(users, int64(len(users)), page, size))
		return
	}

	offset := (page - 1) * size
	var users []models.User
	var total int64
	if err := h.db.WithContext(c.Request.Context()).Model(&models.User{}).Count(&total).Error; err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	if err := h.db.WithContext(c.Request.Context()).Order("id DESC").Offset(offset).Limit(size).Find(&users).Error; err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, response.NewPage(users, total, page, size))
}

// GetUser 查询单个用户。
func (h *Handlers) GetUser(c *gin.Context) {
	var req types.IDRequest
	if err := c.ShouldBindUri(&req); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}
	id := req.ID

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}

	var user models.User
	if err := h.db.WithContext(c.Request.Context()).First(&user, id).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, user)
}

// CreateUser 创建用户。
func (h *Handlers) CreateUser(c *gin.Context) {
	var req types.CreateUserRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	user := models.User{Name: req.Name, Email: req.Email, Phone: req.Phone}
	if h.db == nil {
		user.ID = time.Now().Unix()
		user.CreatedAt = time.Now()
		respgin.Created(c, user)
		return
	}

	if err := h.db.WithContext(c.Request.Context()).Create(&user).Error; err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Created(c, user)
}

// UpdateUser 更新用户。
func (h *Handlers) UpdateUser(c *gin.Context) {
	var idReq types.IDRequest
	if err := c.ShouldBindUri(&idReq); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}
	id := idReq.ID

	var req types.UpdateUserRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}

	var user models.User
	if err := h.db.WithContext(c.Request.Context()).First(&user, id).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}

	if req.Name != nil {
		user.Name = *req.Name
	}
	if req.Email != nil {
		user.Email = *req.Email
	}
	if req.Phone != nil {
		user.Phone = *req.Phone
	}

	if err := h.db.WithContext(c.Request.Context()).Save(&user).Error; err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, user)
}

// DeleteUser 删除用户。
func (h *Handlers) DeleteUser(c *gin.Context) {
	var req types.IDRequest
	if err := c.ShouldBindUri(&req); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}
	id := req.ID

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}

	result := h.db.WithContext(c.Request.Context()).Delete(&models.User{}, id)
	if result.Error != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	if result.RowsAffected == 0 {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}
	respgin.NoContent(c)
}
