// Role-Permission assignment

// AssignPermissionsToRole assigns permissions to a role (replaces existing).
func (h *Handlers) AssignPermissionsToRole(c *gin.Context) {
	var req types.AssignPermissionsRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	// Verify role exists
	var role models.Role
	if err := h.db.WithContext(c.Request.Context()).First(&role, req.RoleID).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}

	// Replace permissions in a transaction
	err := h.db.WithContext(c.Request.Context()).Transaction(func(tx *gorm.DB) error {
		if err := tx.Where("role_id = ?", req.RoleID).Delete(&models.RolePermission{}).Error; err != nil {
			return err
		}
		if len(req.PermissionIDs) == 0 {
			return nil
		}
		var perms []models.RolePermission
		for _, pid := range req.PermissionIDs {
			perms = append(perms, models.RolePermission{RoleID: req.RoleID, PermissionID: pid})
		}
		return tx.Create(&perms).Error
	})
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, gin.H{"message": "permissions assigned"})
}

// GetRolePermissions returns all permissions assigned to a role.
func (h *Handlers) GetRolePermissions(c *gin.Context) {
	var idReq types.IDRequest
	if err := c.ShouldBindUri(&idReq); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	var perms []models.Permission
	err := h.db.WithContext(c.Request.Context()).
		Joins("JOIN role_permissions ON role_permissions.permission_id = permissions.id").
		Where("role_permissions.role_id = ?", idReq.ID).
		Find(&perms).Error
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	result := make([]types.PermissionResponse, len(perms))
	for i := range perms {
		result[i] = types.ToPermissionResponse(&perms[i])
	}
	respgin.Success(c, types.RolePermissionResponse{
		RoleID:      idReq.ID,
		Permissions: result,
	})
}

// User-Role assignment

// AssignRoleToUser assigns a role to a user.
func (h *Handlers) AssignRoleToUser(c *gin.Context) {
	var req types.AssignRoleRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	// Check for duplicate
	var count int64
	h.db.WithContext(c.Request.Context()).Model(&models.UserRole{}).
		Where("user_id = ? AND role_id = ?", req.UserID, req.RoleID).Count(&count)
	if count > 0 {
		respgin.WriteError(c, response.New(response.CodeConflict, "role already assigned to user"))
		return
	}

	ur := models.UserRole{UserID: req.UserID, RoleID: req.RoleID}
	if err := h.db.WithContext(c.Request.Context()).Create(&ur).Error; err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, gin.H{"message": "role assigned"})
}

// RevokeRoleFromUser removes a role from a user.
func (h *Handlers) RevokeRoleFromUser(c *gin.Context) {
	var req types.AssignRoleRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}

	if h.db == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	result := h.db.WithContext(c.Request.Context()).
		Where("user_id = ? AND role_id = ?", req.UserID, req.RoleID).
		Delete(&models.UserRole{})
	if result.Error != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	if result.RowsAffected == 0 {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}
	respgin.NoContent(c)
}

