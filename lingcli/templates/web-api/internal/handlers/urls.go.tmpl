package handlers

import (
	"time"

	"{{.Module}}/internal/configs"
	{{- if .HasJWT}}
	"github.com/LingByte/ling-base/common/jwtutil"
	{{- end}}
	{{- if .HasCache}}
	"github.com/LingByte/ling-base/common/cache"
	{{- end}}
	{{- if .HasLock}}
	"github.com/LingByte/ling-base/common/lock/memory"
	{{- end}}
	{{- if .HasRetry}}
	"github.com/LingByte/ling-base/common/retry"
	{{- end}}
	{{- if .HasStores}}
	"github.com/LingByte/ling-base/stores"
	{{- end}}

	{{- if .HasAPIDocs}}
	"github.com/LingByte/ling-base/apidocs/humax"
	"github.com/danielgtaylor/huma/v2"
	{{- end}}
	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
)

// AppInfo 应用信息。
type AppInfo struct {
	Name      string
	Version   string
	BuildTime string
	GitCommit string
	{{- if .HasJWT}}
	JWTAuth  *jwtutil.Auth
	{{- end}}
	{{- if .HasStores}}
	Store    stores.Store
	{{- end}}
	{{- if .HasCache}}
	Cache    cache.ByteCache
	{{- end}}
	{{- if .HasLock}}
	LockManager *memory.Manager
	{{- end}}
	{{- if .HasRetry}}
	RetryOpts []retry.Option
	{{- end}}
}

// Handlers HTTP 请求处理器集合（直接操作 db，无 service/repository 层）。
type Handlers struct {
	cfg       *configs.Config
	info      AppInfo
	db        *gorm.DB
	startTime time.Time
	{{- if .HasJWT}}
	jwtAuth   *jwtutil.Auth
	{{- end}}
	{{- if .HasStores}}
	store     stores.Store
	{{- end}}
	{{- if .HasCache}}
	cache     cache.ByteCache
	{{- end}}
	{{- if .HasLock}}
	lockMgr   *memory.Manager
	{{- end}}
	{{- if .HasRetry}}
	retryOpts []retry.Option
	{{- end}}
}

// New 创建 Handlers。
func New(cfg *configs.Config, info AppInfo, db *gorm.DB) *Handlers {
	return &Handlers{
		cfg:       cfg,
		info:      info,
		db:        db,
		startTime: time.Now(),
		{{- if .HasJWT}}
		jwtAuth:   info.JWTAuth,
		{{- end}}
		{{- if .HasStores}}
		store:     info.Store,
		{{- end}}
		{{- if .HasCache}}
		cache:     info.Cache,
		{{- end}}
		{{- if .HasLock}}
		lockMgr:   info.LockManager,
		{{- end}}
		{{- if .HasRetry}}
		retryOpts: info.RetryOpts,
		{{- end}}
	}
}

{{- if .HasAPIDocs}}

// Register 通过 humax.Group 注册所有路由（Gin 执行 + OpenAPI 文档）。
func (h *Handlers) Register(engine *gin.Engine, api huma.API) {
	r := humax.NewGroup(api, engine, "")
	h.registerRoutes(r)
}

{{- else}}

// Register 通过 Gin 注册所有路由。
func (h *Handlers) Register(engine *gin.Engine) {
	h.registerRoutes(engine)
}

{{- end}}

// registerRoutes 注册所有路由（系统端点 + 用户 CRUD{{if .HasJWT}} + 鉴权{{end}}）。
{{- if .HasAPIDocs}}
func (h *Handlers) registerRoutes(r *humax.Group) {
{{- else}}
func (h *Handlers) registerRoutes(r gin.IRouter) {
{{- end}}
	// ── 系统端点（公开）──
	r.GET("/health", h.Health)
	r.GET("/live", h.Liveness)
	r.GET("/ready", h.Readiness)
	r.GET("/api/v1/version", h.Version)

	{{- if .HasJWT}}
	// ── 鉴权（公开）──
	authGroup := r.Group("/api/v1/auth")
	{
		authGroup.POST("/login", h.Login)
		authGroup.POST("/refresh", h.Refresh)
	}
	{{- end}}

	// ── 用户 CRUD ──
	users := r.Group("/api/v1/users")
	{
		users.GET("", h.ListUsers)
		users.GET("/:id", h.GetUser)
		users.POST("", h.CreateUser)
		users.PUT("/:id", h.UpdateUser)
		users.DELETE("/:id", h.DeleteUser)
	}

	{{- if .HasStores}}
	// ── 文件存储（上传/下载/删除）──
	files := r.Group("/api/v1/files")
	{
		files.POST("/upload", h.UploadFile)
		files.GET("/:key", h.DownloadFile)
		files.DELETE("/:key", h.DeleteFile)
	}
	{{- end}}
}
