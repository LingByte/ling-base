{{- if .HasJWT}}

package handlers

import (
	"{{.Module}}/internal/types"

	"github.com/LingByte/ling-base/common/jwtutil"
	"github.com/LingByte/ling-base/common/response"
	respgin "github.com/LingByte/ling-base/common/response/gin"
	{{- if .HasValidate}}
	"github.com/LingByte/ling-base/common/validate"
	{{- end}}
	"github.com/gin-gonic/gin"
)

// Login 用户登录，签发 JWT access/refresh token。
func (h *Handlers) Login(c *gin.Context) {
	if h.jwtAuth == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	var req types.LoginRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	// NOTE: This is a demo handler. In production, validate credentials
	// against your database or identity store before issuing tokens.
	// The example below only issues a token without verifying the password.
	pair, err := h.jwtAuth.Login(req.Username)
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, types.TokenResponse{
		AccessToken:  pair.AccessToken,
		RefreshToken: pair.RefreshToken,
		ExpiresIn:    pair.ExpiresIn,
		TokenType:    pair.TokenType,
	})
}

// Refresh 用 refresh token 换取新的 access/refresh token。
func (h *Handlers) Refresh(c *gin.Context) {
	if h.jwtAuth == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	var req types.RefreshRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	pair, err := h.jwtAuth.Refresh(req.RefreshToken)
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeUnauthorized))
		return
	}
	respgin.Success(c, types.TokenResponse{
		AccessToken:  pair.AccessToken,
		RefreshToken: pair.RefreshToken,
		ExpiresIn:    pair.ExpiresIn,
		TokenType:    pair.TokenType,
	})
}

// ClaimsFromContext 从 gin.Context 提取 JWT claims（需在 jwtingin.Middleware 之后）。
func ClaimsFromContext(c *gin.Context) *jwtutil.Claims {
	if v, ok := c.Get("jwt_claims"); ok {
		if claims, ok := v.(*jwtutil.Claims); ok {
			return claims
		}
	}
	return nil
}
{{- end}}
