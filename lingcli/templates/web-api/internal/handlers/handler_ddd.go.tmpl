// ListUsersDDD returns a paginated, filterable list of users via the application service.
func (h *Handlers) ListUsersDDD(c *gin.Context) {
	var req types.UserListRequest
	if err := c.ShouldBindQuery(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	page, size := req.Normalize()

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	users, total, err := h.userApp.ListUsers(page, size, req.Keyword, req.Status, req.Role)
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}

	result := make([]types.UserResponse, len(users))
	for i, u := range users {
		result[i] = domainUserToResponse(u)
	}
	respgin.Success(c, response.NewPage(result, total, page, size))
}

// GetUserDDD returns a single user by ID via the application service.
func (h *Handlers) GetUserDDD(c *gin.Context) {
	var req types.IDRequest
	if err := c.ShouldBindUri(&req); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	user, err := h.userApp.GetUser(req.ID)
	if err != nil {
		if errors.Is(err, domain.ErrUserNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, domainUserToResponse(user))
}

// RegisterUserDDD creates a new user account (public registration) via the application service.
func (h *Handlers) RegisterUserDDD(c *gin.Context) {
	var req types.RegisterRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	user, err := h.userApp.Register(application.RegisterInput{
		Username: req.Username,
		Email:    req.Email,
		Password: req.Password,
		Phone:    req.Phone,
	})
	if err != nil {
		if errors.Is(err, domain.ErrUserExists) {
			respgin.WriteError(c, response.New(response.CodeConflict, "username or email already exists"))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Created(c, domainUserToResponse(user))
}

