// UpdateUserDDD updates a user's profile via the application service.
func (h *Handlers) UpdateUserDDD(c *gin.Context) {
	var idReq types.IDRequest
	if err := c.ShouldBindUri(&idReq); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	var req types.UpdateUserRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	user, err := h.userApp.UpdateUser(application.UpdateUserInput{
		ID:       idReq.ID,
		Username: req.Username,
		Email:    req.Email,
		Phone:    req.Phone,
		Avatar:   req.Avatar,
		Role:     req.Role,
		Status:   req.Status,
	})
	if err != nil {
		if errors.Is(err, domain.ErrUserNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, domainUserToResponse(user))
}

// ChangePasswordDDD changes a user's password via the application service.
func (h *Handlers) ChangePasswordDDD(c *gin.Context) {
	var idReq types.IDRequest
	if err := c.ShouldBindUri(&idReq); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	var req types.ChangePasswordRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- if .HasValidate}}
	if err := validate.Validate(&req); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}
	{{- end}}

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	err := h.userApp.ChangePassword(application.ChangePasswordInput{
		UserID:      idReq.ID,
		OldPassword: req.OldPassword,
		NewPassword: req.NewPassword,
	})
	if err != nil {
		if errors.Is(err, domain.ErrUserNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		if errors.Is(err, domain.ErrPasswordMismatch) {
			respgin.WriteError(c, response.New(response.CodeUnauthorized, "incorrect old password"))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.Success(c, gin.H{"message": "password changed"})
}

// DeleteUserDDD soft-deletes a user via the application service.
func (h *Handlers) DeleteUserDDD(c *gin.Context) {
	var req types.IDRequest
	if err := c.ShouldBindUri(&req); err != nil {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	if h.userApp == nil {
		respgin.WriteError(c, response.Err(response.CodeServiceUnavail))
		return
	}

	if err := h.userApp.DeleteUser(req.ID); err != nil {
		if errors.Is(err, domain.ErrUserNotFound) {
			respgin.WriteError(c, response.Err(response.CodeNotFound))
			return
		}
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	respgin.NoContent(c)
}

// domainUserToResponse converts a domain.User to a UserResponse DTO.
func domainUserToResponse(u *domain.User) types.UserResponse {
	return types.UserResponse{
		ID:          u.ID,
		Username:    u.Username,
		Email:       u.Email,
		Phone:       u.Phone,
		Avatar:      u.Avatar,
		Role:        u.Role,
		Status:      u.Status,
		LastLoginAt: u.LastLoginAt,
		CreatedAt:   u.CreatedAt,
		UpdatedAt:   u.UpdatedAt,
	}
}

// Ensure time is referenced (used in domain.User.CreatedAt conversions).
var _ = time.Now
