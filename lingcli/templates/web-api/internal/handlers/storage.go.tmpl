// ──────────────────────────────────────────────
// 文件上传 / 下载 / 删除
// 直接使用 pkg/storage 包级单例,无需依赖注入。
// ──────────────────────────────────────────────

// UploadFile 处理文件上传。
// 表单字段名: file（multipart/form-data）
// 可选字段: dir（子目录，如 "avatars"）
//
// 上传流程:
//  1. 校验文件大小（不超过 storage.MaxFileSize）
//  2. 生成唯一 key（dir + 时间戳 + 原始文件名）
//  3. 调用 pkgstorage.Write 存储
//  4. 返回 key + publicURL
func (h *Handlers) UploadFile(c *gin.Context) {
	file, err := c.FormFile("file")
	if err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, "未提供文件: "+err.Error()))
		return
	}

	// 校验文件大小
	if err = pkgstorage.CheckFileSize(file.Size); err != nil {
		respgin.WriteError(c, response.New(response.CodeBadRequest, err.Error()))
		return
	}

	// 可选子目录
	dir := sanitizePath(strings.TrimSpace(c.PostForm("dir")))

	// 生成唯一 key: dir/20060102_150405_filename
	filename := sanitizePath(filepath.Base(file.Filename))
	key := fmt.Sprintf("%s/%s_%s", dir, time.Now().Format("20060102_150405"), filename)
	if dir == "" {
		key = fmt.Sprintf("%s_%s", time.Now().Format("20060102_150405"), filename)
	}

	// 打开上传文件
	src, err := file.Open()
	if err != nil {
		respgin.WriteError(c, response.New(response.CodeInternal, "打开文件失败: "+err.Error()))
		return
	}
	defer src.Close()

	// 写入存储
	if err = pkgstorage.Write(key, src); err != nil {
		respgin.WriteError(c, response.New(response.CodeInternal, "存储失败: "+err.Error()))
		return
	}

	respgin.Created(c, types.FileUploadResponse{
		Key:       key,
		Name:      filename,
		Size:      file.Size,
		PublicURL: pkgstorage.PublicURL(key),
	})
}

// DownloadFile 处理文件下载。
// 路径参数: key（存储 key）
func (h *Handlers) DownloadFile(c *gin.Context) {
	key := c.Param("key")
	if key == "" {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	reader, size, err := pkgstorage.Read(key)
	if err != nil {
		respgin.WriteError(c, response.New(response.CodeNotFound, "文件不存在"))
		return
	}
	defer reader.Close()

	c.Header("Content-Disposition", fmt.Sprintf(`attachment; filename="%s"`, filepath.Base(key)))
	c.DataFromReader(200, size, "application/octet-stream", reader, nil)
}

// DeleteFile 处理文件删除。
// 路径参数: key（存储 key）
func (h *Handlers) DeleteFile(c *gin.Context) {
	key := c.Param("key")
	if key == "" {
		respgin.WriteError(c, response.Err(response.CodeBadRequest))
		return
	}

	exists, err := pkgstorage.Exists(key)
	if err != nil {
		respgin.WriteError(c, response.Err(response.CodeInternal))
		return
	}
	if !exists {
		respgin.WriteError(c, response.Err(response.CodeNotFound))
		return
	}

	if err = pkgstorage.Delete(key); err != nil {
		respgin.WriteError(c, response.New(response.CodeInternal, "删除失败: "+err.Error()))
		return
	}

	respgin.NoContent(c)
}

// sanitizePath 清理路径，防止目录穿越。
// 去除 ..、前导 / 等。
func sanitizePath(p string) string {
	p = strings.TrimSpace(p)
	p = strings.TrimPrefix(p, "/")
	p = strings.ReplaceAll(p, "..", "")
	for strings.Contains(p, "//") {
		p = strings.ReplaceAll(p, "//", "/")
	}
	return p
}
