package app

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"time"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/handler"
	"{{.Module}}/internal/model"

	"github.com/LingByte/ling-base/bootstrap"
	"github.com/LingByte/ling-base/constants"
	"github.com/LingByte/ling-base/logger"
	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
)

// AppInfo 持有应用元信息。
type AppInfo struct {
	Name      string
	Version   string
	BuildTime string
	GitCommit string
	Port      int
}

// Run 启动应用。
func Run(info *AppInfo) {
	// 加载配置
	cfg, err := config.Load("configs/config.yaml")
	if err != nil {
		fmt.Fprintf(os.Stderr, "加载配置失败: %v\n", err)
		os.Exit(1)
	}

	// 初始化时区
	logger.InitTimezone(constants.TimezoneShanghai)

	// 初始化日志（zap + lumberjack 轮转 + 脱敏）
	if err := logger.Init(&logger.LogConfig{
		Level:           cfg.Logging.Level,
		Filename:        cfg.Logging.Filename,
		MaxSize:         cfg.Logging.MaxSize,
		MaxAge:          cfg.Logging.MaxAge,
		MaxBackups:      cfg.Logging.MaxBackups,
		Daily:           cfg.Logging.Daily,
		SensitiveFields: cfg.Logging.SensitiveFields,
	}, cfg.App.Environment); err != nil {
		fmt.Fprintf(os.Stderr, "初始化日志失败: %v\n", err)
		os.Exit(1)
	}

	// 创建 bootstrap 应用
	appOpts := []bootstrap.Option{
		bootstrap.WithProfile(cfg.App.Environment),
		bootstrap.WithBannerText(info.Name),
		bootstrap.WithShutdownTimeout(15 * time.Second),
	}

	// 数据库迁移
	if cfg.Database.DSN != "" {
		db, err := config.InitDB(cfg.Database)
		if err != nil {
			logger.Lg.Error("数据库初始化失败", zap.Error(err))
			os.Exit(1)
		}
		// dev/test: AutoMigrate; prod: 手动 SQL 迁移
		if cfg.App.Environment == "dev" || cfg.App.Environment == "test" {
			appOpts = append(appOpts, bootstrap.WithAutoMigrate(db, &model.User{}))
		}
	}

	app := bootstrap.New(info.Name, appOpts...)

	// 注册 HTTP 服务器为生命周期组件
	app.Register("http-server", &httpServerComponent{info: info, cfg: cfg})

	// 启动（阻塞直到收到关闭信号）
	if err := app.Run(); err != nil {
		logger.Lg.Error("应用启动失败", zap.Error(err))
		os.Exit(1)
	}
}

// httpServerComponent 管理 HTTP 服务器的生命周期。
type httpServerComponent struct {
	info    *AppInfo
	cfg     *config.Config
	server  *http.Server
	running bool
}

func (c *httpServerComponent) Start(ctx context.Context) error {
	// 生产环境用 Release 模式
	if c.cfg.App.Environment == "prod" {
		gin.SetMode(gin.ReleaseMode)
	}

	r := gin.New()

	// 注册路由和中间件
	handler.RegisterRoutes(r, c.cfg, handler.AppInfo{
		Name:      c.info.Name,
		Version:   c.info.Version,
		BuildTime: c.info.BuildTime,
		GitCommit: c.info.GitCommit,
	})

	c.server = &http.Server{
		Addr:         fmt.Sprintf(":%d", c.info.Port),
		Handler:      r,
		ReadTimeout:  c.cfg.Server.ReadTimeout,
		WriteTimeout: c.cfg.Server.WriteTimeout,
		IdleTimeout:  c.cfg.Server.IdleTimeout,
	}

	go func() {
		logger.Lg.Info("HTTP 服务已启动",
			zap.String("addr", c.server.Addr),
			zap.String("version", c.info.Version))
		if err := c.server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			logger.Lg.Error("HTTP 服务异常", zap.Error(err))
		}
	}()

	c.running = true
	return nil
}

func (c *httpServerComponent) Stop(ctx context.Context) error {
	logger.Lg.Info("正在关闭 HTTP 服务...")
	c.running = false
	return c.server.Shutdown(ctx)
}

func (c *httpServerComponent) IsRunning() bool {
	return c.running
}
