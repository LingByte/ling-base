{{- if .IsYAMLConfig}}
# {{.ProjectName}} 生产环境配置覆盖

server:
  port: {{.Port}}
  readTimeout: 10s
  writeTimeout: 10s

database:
  driver: mysql
  dsn: root:password@tcp(mysql:3306)/{{.ProjectName}}?charset=utf8mb4&parseTime=True
  maxOpenConns: 100
  maxIdleConns: 20
  connMaxLifetime: 3m

redis:
  addr: redis:6379
  password: ""
  db: 0

logging:
  level: info
  format: json

# 生产环境开启限流
rateLimit:
  enabled: true
  rps: 200
  burst: 500

# 生产环境开启熔断
circuitBreaker:
  enabled: true
  failureThreshold: 5
  minRequests: 20
  recoveryTimeout: 30s

# 生产环境关闭文档 UI（保留 spec 可选）
docs:
  enabled: false
  cdnMode: selfhosted
  cdnBaseUrl: "https://assets.internal.company.com/openapi-ui"

# 生产环境开启 JWT
jwt:
  enabled: true
  secret: "set-via-env-var-in-prod"
  accessTTL: 15m
  refreshTTL: 168h

# 生产环境切换到云存储（示例: S3）
# 需先: go get github.com/LingByte/ling-base/stores/s3
storage:
  driver: local            # 生产环境改为 s3/oss/cos 等
  root: uploads
  maxFileSize: 104857600   # 100 MB

# 生产环境切换到 Redis 缓存
# 需先: go get github.com/LingByte/ling-base/common/cache/redis
cache:
  driver: memory           # 生产环境改为 redis
  defaultTTL: 5m

# 生产环境切换到 Redis 分布式锁
# 需先: go get github.com/LingByte/ling-base/common/lock/redis
lock:
  driver: memory           # 生产环境改为 redis
  defaultTTL: 30s

retry:
  maxAttempts: 5
  initialDelay: 200ms
  maxDelay: 30s
  jitter: true

# 生产环境启用降级
fallback:
  enabled: true
  defaultMessage: "服务暂时不可用,请稍后再试"
  statusCode: 503

app:
  name: {{.ProjectName}}
  environment: prod
{{- end}}
