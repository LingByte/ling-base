# {{.ProjectName}} 配置文件

server:
  port: {{.Port}}
  readTimeout: 15s
  writeTimeout: 15s
  idleTimeout: 60s

database:
  driver: sqlite          # mysql | postgres | sqlite
  dsn: ""                 # 留空则不连接数据库；SQLite 示例: data/app.db
  # dsn: root:password@tcp(127.0.0.1:3306)/{{.ProjectName}}?charset=utf8mb4&parseTime=True  # MySQL
  # dsn: host=localhost user=postgres password=secret dbname={{.ProjectName}} port=5432 sslmode=disable  # PostgreSQL
  maxOpenConns: 25
  maxIdleConns: 10
  connMaxLifetime: 5m

redis:
  addr: localhost:6379
  password: ""
  db: 0

logging:
  level: info             # debug | info | warn | error
  filename: logs/app.log  # 日志文件路径
  maxSize: 100            # 单文件最大 MB
  maxAge: 30              # 保留天数
  maxBackups: 10          # 备份数量
  daily: true             # 按天轮转
  sensitiveFields: ""     # 脱敏字段（逗号分隔）

# 限流（ling-base/common/limiter）
rateLimit:
  enabled: false
  rps: 100
  burst: 200

# 熔断器（ling-base/common/circuitbreaker）
circuitBreaker:
  enabled: false
  failureThreshold: 0.5   # 50% 失败率触发熔断
  minRequests: 10         # 最少请求数才开始评估
  recoveryTimeout: 30s    # 熔断后恢复探测时间

# API 文档（ling-base/apidocs）
docs:
  enabled: true           # 生产环境可设为 false
  path: /docs
  theme: scalar           # scalar | swagger | redoc | stoplight
  darkMode: false
  cdnMode: public         # public | selfhosted | custom
  cdnBaseUrl: ""          # selfhosted 模式下的资源基址

# JWT 鉴权（ling-base/common/jwtutil）
jwt:
  enabled: false
  secret: "change-me-in-production-32bytes!"
  issuer: {{.ProjectName}}
  accessTTL: 15m
  refreshTTL: 168h        # 7 天

app:
  name: {{.ProjectName}}
  environment: dev        # dev | test | staging | prod
