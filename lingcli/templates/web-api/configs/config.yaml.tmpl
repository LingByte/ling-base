{{- if .IsYAMLConfig}}
# {{.ProjectName}} 配置文件

server:
  port: {{.Port}}
  readTimeout: 15s
  writeTimeout: 15s
  idleTimeout: 60s

database:
  driver: sqlite          # mysql | postgres | sqlite
  dsn: ""                 # 留空则不连接数据库；SQLite 示例: data/app.db
  # dsn: root:password@tcp(127.0.0.1:3306)/{{.ProjectName}}?charset=utf8mb4&parseTime=True  # MySQL
  # dsn: host=localhost user=postgres password=secret dbname={{.ProjectName}} port=5432 sslmode=disable  # PostgreSQL
  maxOpenConns: 25
  maxIdleConns: 10
  connMaxLifetime: 5m

redis:
  addr: localhost:6379
  password: ""
  db: 0

logging:
  level: info             # debug | info | warn | error
  filename: logs/app.log  # 日志文件路径
  maxSize: 100            # 单文件最大 MB
  maxAge: 30              # 保留天数
  maxBackups: 10          # 备份数量
  daily: true             # 按天轮转
  sensitiveFields: ""     # 脱敏字段（逗号分隔）

# 限流（ling-base/common/limiter）
rateLimit:
  enabled: false
  rps: 100
  burst: 200

# 熔断器（ling-base/common/circuitbreaker）
circuitBreaker:
  enabled: false
  failureThreshold: 5     # 失败次数阈值
  minRequests: 10         # 最少请求数才开始评估
  recoveryTimeout: 30s    # 熔断后恢复探测时间

# API 文档（ling-base/apidocs）
docs:
  enabled: true           # 生产环境可设为 false
  path: /docs
  theme: scalar           # scalar | swagger | redoc | stoplight
  darkMode: false
  cdnMode: public         # public | selfhosted | custom
  cdnBaseUrl: ""          # selfhosted 模式下的资源基址

# JWT 鉴权（ling-base/common/jwtutil）
jwt:
  enabled: false
  secret: "change-me-in-prod-32bytes!"
  issuer: {{.ProjectName}}
  accessTTL: 15m
  refreshTTL: 168h        # 7 天

# 国际化（ling-base/i18n）
i18n:
  enabled: {{.HasI18n}}
  defaultLocale: zh-CN     # 默认语言
  supportedLocales:        # 支持的语言列表
    - en
    - zh-CN
  fallbackLocale: en       # 回退语言（翻译缺失时使用）
  translationsPath: i18n/translations  # 翻译文件目录

# 对象存储（ling-base/stores）— 内置模块
# 默认 local 后端（本地文件系统，零云 SDK 依赖）。
# 切换到云存储时，将 driver 改为对应值并 go get 驱动模块：
#   go get github.com/LingByte/ling-base/stores/s3
#   go get github.com/LingByte/ling-base/stores/oss
storage:
  driver: local            # local | s3 | oss | cos | minio | kodo | tos | obs | ks3
  root: uploads            # local: 根目录; 云存储: bucket 名
  region: ""               # 云存储区域
  endpoint: ""             # 自定义端点（MinIO / S3 兼容）
  accessKey: ""            # 云存储 AccessKey
  secretKey: ""            # 云存储 SecretKey
  publicUrlBase: ""        # 公网访问基址（留空用默认）
  maxFileSize: 10485760    # 单文件最大字节数（10 MB，0 = 不限制）

# 缓存（ling-base/common/cache）— 内置模块
# 默认 memory 后端（进程内，零外部依赖）。
# 切换到 Redis: go get github.com/LingByte/ling-base/common/cache/redis
cache:
  driver: memory           # memory | redis | bigcache | freecache | ristretto
  defaultTTL: 10m          # 默认 TTL
  cleanupInterval: 1m      # memory: GC 间隔
  redisAddr: ""            # redis 后端专用（留空复用顶层 redis 配置）
  redisPassword: ""
  redisDB: 0

# 分布式锁（ling-base/common/lock）— 内置模块
# 默认 memory 后端（进程内，单实例）。
# 切换到 Redis: go get github.com/LingByte/ling-base/common/lock/redis
lock:
  driver: memory           # memory | redis | etcd | zookeeper | consul | mysql | postgres
  defaultTTL: 10s          # 默认锁 TTL
  retryDelay: 50ms         # 获取锁重试间隔
  redisAddr: ""            # redis 后端专用（留空复用顶层 redis 配置）
  redisPassword: ""
  redisDB: 0

# 重试策略（ling-base/common/retry）— 内置模块
retry:
  maxAttempts: 3           # 最大尝试次数（含首次）
  initialDelay: 100ms      # 初始退避延迟
  maxDelay: 10s            # 退避上限
  factor: "2.0"            # 退避乘数
  jitter: true             # 是否启用抖动（避免惊群）

# 降级（pkg/fallback）— 内置模块
# 熔断器打开或远程调用失败时,返回降级响应而非 5xx
fallback:
  enabled: true            # 是否启用降级
  defaultMessage: "服务暂时不可用,请稍后再试"
  statusCode: 503          # 降级 HTTP 状态码

app:
  name: {{.ProjectName}}
  environment: dev        # dev | test | prod（对应 constants.ENV_DEV / ENV_PROD）
{{- end}}
