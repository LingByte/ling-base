{{- if .IsEnvConfig}}
# {{.ProjectName}} 配置文件（.env 格式）
# 所有配置项通过环境变量注入，格式：APP_<SECTION>_<FIELD>=VALUE

# ── 应用 ──
APP_APP_NAME={{.ProjectName}}
APP_APP_ENVIRONMENT=dev

# ── 服务器 ──
APP_SERVER_PORT={{.Port}}

# ── 数据库 ──
APP_DATABASE_DRIVER=sqlite
APP_DATABASE_DSN=
# MySQL 示例: APP_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/{{.ProjectName}}?charset=utf8mb4&parseTime=True
# PostgreSQL 示例: APP_DATABASE_DSN=host=localhost user=postgres password=secret dbname={{.ProjectName}} port=5432 sslmode=disable

# ── Redis ──
APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=

# ── JWT 鉴权 ──
APP_JWT_ENABLED=false
APP_JWT_SECRET=change-me-in-prod-32bytes!

# ── API 文档 ──
APP_DOCS_ENABLED=true

# ── 限流 ──
APP_RATELIMIT_ENABLED=false
APP_RATELIMIT_RPS=100
{{- end}}
