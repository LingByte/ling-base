{{- if .IsEnvConfig}}
# {{.ProjectName}} 生产环境配置（.env 格式）
# 生产环境通过环境变量注入，此文件作为参考模板

# ── 应用 ──
APP_APP_NAME={{.ProjectName}}
APP_APP_ENVIRONMENT=prod

# ── 服务器 ──
APP_SERVER_PORT={{.Port}}

# ── 数据库（生产环境用 MySQL）──
APP_DATABASE_DRIVER=mysql
APP_DATABASE_DSN=root:password@tcp(mysql:3306)/{{.ProjectName}}?charset=utf8mb4&parseTime=True

# ── Redis ──
APP_REDIS_ADDR=redis:6379
APP_REDIS_PASSWORD=

# ── JWT 鉴权（生产环境开启）──
APP_JWT_ENABLED=true
APP_JWT_SECRET=set-via-env-var-in-production

# ── API 文档（生产环境关闭 UI）──
APP_DOCS_ENABLED=false

# ── 限流（生产环境开启）──
APP_RATELIMIT_ENABLED=true
APP_RATELIMIT_RPS=200
{{- end}}
