# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace: this repo commits go.work for multi-module local development.
# go.work.sum is regenerated by `go work sync`.
go.work.sum

# env file
.env

# SQLite test database
*.db
*.db-journal

# Editor/IDE
.idea/
.vscode/
dump.rdb
apidocs/assets/.DS_Store
*.DS_Store

# lingcli: only ignore the compiled binary, not the source directory
/lingcli/lingcli

# lingcli embed_source: only keep .gitkeep, ignore synced source
/lingcli/embed_source/*
!/lingcli/embed_source/.gitkeep

# agent: only ignore compiled binaries, not source
/example/cmd/ling-agent/ling-agent
/bin/

# agent sandbox: OS sandbox mode (config.SandboxOS) uses the project directory
# as the workspace root. EnsureLayout creates these subdirs + metadata.json
# inside it. They are harmless runtime artifacts, not source files.
# Note: /out/ is already ignored above. skills/ is NOT ignored here because it
# may conflict with user project directories; the sandbox creates it only when
# it doesn't already exist.
/metadata.json
/work/
/runs/

# deps
/node_modules

# generated content
.source

# test & build
/coverage
/.next/
/out/
/build
*.tsbuildinfo

# misc
.DS_Store
*.pem
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# others
.env*.local
.vercel
next-env.d.ts